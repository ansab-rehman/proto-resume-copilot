# OpenAI-compatible endpoint (default: Z.ai GLM). Backend-configured only; never user-supplied.
LLM_BASE_URL=https://api.z.ai/api/paas/v4/
LLM_API_KEY=
LLM_MODEL=glm-4.6
# JSON passthrough merged into each request body. GLM thinks at max effort by default (slow).
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# json_object (default) | json_schema
LLM_RESPONSE_FORMAT=json_object
MAX_UPLOAD_MB=5
DATABASE_URL=sqlite:///./copilot.db
